<?xml version='1.0' encoding='utf-8'?>
<robot name="my_robot">
    <!--SI units; +X forward, +Y left, +Z up. Geometry prototype, not a belt-drive simulation.-->
    <material name="body_gray">
        <color rgba=".48 .50 .52 1" />
    </material>
    <material name="head_gray">
        <color rgba=".78 .80 .82 1" />
    </material>
    <material name="track_dark">
        <color rgba=".09 .10 .11 1" />
    </material>
    <material name="wheel_gray">
        <color rgba=".34 .36 .38 1" />
    </material>
    <link name="base_footprint" />
    <link name="base_link">
        <visual name="floor">
            <origin xyz="0 0 0.024" rpy="0 0 0" />
            <geometry>
                <box size="0.19 0.108 0.008" />
            </geometry>
            <material name="body_gray" />
        </visual>
        <collision name="floor">
            <origin xyz="0 0 0.024" rpy="0 0 0" />
            <geometry>
                <box size="0.19 0.108 0.008" />
            </geometry>
        </collision>
        <visual name="rear_bay">
            <origin xyz="-0.049 0 0.053" rpy="0 0 0" />
            <geometry>
                <box size="0.092 0.092 0.05" />
            </geometry>
            <material name="body_gray" />
        </visual>
        <collision name="rear_bay">
            <origin xyz="-0.049 0 0.053" rpy="0 0 0" />
            <geometry>
                <box size="0.092 0.092 0.05" />
            </geometry>
        </collision>
        <visual name="front_lip">
            <origin xyz="0.091 0 0.038" rpy="0 0 0" />
            <geometry>
                <box size="0.008 0.092 0.02" />
            </geometry>
            <material name="body_gray" />
        </visual>
        <collision name="front_lip">
            <origin xyz="0.091 0 0.038" rpy="0 0 0" />
            <geometry>
                <box size="0.008 0.092 0.02" />
            </geometry>
        </collision>
        <visual name="left_cheek">
            <origin xyz="0 0.05 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://robot_description/meshes/body_cheek.stl" />
            </geometry>
            <material name="body_gray" />
        </visual>
        <collision name="left_cheek_lower">
            <origin xyz="0 0.05 0.035" rpy="0 0 0" />
            <geometry>
                <box size=".190 .008 .020" />
            </geometry>
        </collision>
        <collision name="left_cheek_upper">
            <origin xyz="-0.02 0.05 0.0585" rpy="0 0 0" />
            <geometry>
                <box size=".150 .008 .027" />
            </geometry>
        </collision>
        <visual name="right_cheek">
            <origin xyz="0 -0.05 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://robot_description/meshes/body_cheek.stl" />
            </geometry>
            <material name="body_gray" />
        </visual>
        <collision name="right_cheek_lower">
            <origin xyz="0 -0.05 0.035" rpy="0 0 0" />
            <geometry>
                <box size=".190 .008 .020" />
            </geometry>
        </collision>
        <collision name="right_cheek_upper">
            <origin xyz="-0.02 -0.05 0.0585" rpy="0 0 0" />
            <geometry>
                <box size=".150 .008 .027" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.027423529411764708 0.0 0.04587058823529412" />
            <mass value="0.85" />
            <inertia ixx="0.00104297243137" ixy="0" ixz="0.000220786588235" iyy="0.00243429996078" iyz="0" izz="0.00297439419608" />
        </inertial>
    </link>
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="head_link">
        <visual name="head_sphere">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius=".045" />
            </geometry>
            <material name="head_gray" />
        </visual>
        <collision name="head_sphere">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius=".045" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="0.2" />
            <inertia ixx="0.000162" ixy="0" ixz="0" iyy="0.000162" iyz="0" izz="0.000162" />
        </inertial>
    </link>
    <joint name="head_pitch_joint" type="revolute">
        <parent link="base_link" />
        <child link="head_link" />
        <origin xyz="0.047 0 0.075" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-.610865" upper=".610865" effort="0.5" velocity="1.0" />
        <dynamics damping="0.02" friction="0.001" />
    </joint>
    <link name="left_track_link">
        <visual name="left_belt_envelope">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://robot_description/meshes/track_envelope.stl" />
            </geometry>
            <material name="track_dark" />
        </visual>
        <collision name="left_contact">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size=".130 .025 .050" />
            </geometry>
        </collision>
        <collision name="front_round_end">
            <origin xyz="0.065 0 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".025" length=".025" />
            </geometry>
        </collision>
        <visual name="front_wheel_visual">
            <origin xyz="0.065 0.0126 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".021" length=".001" />
            </geometry>
            <material name="wheel_gray" />
        </visual>
        <collision name="rear_round_end">
            <origin xyz="-0.065 0 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".025" length=".025" />
            </geometry>
        </collision>
        <visual name="rear_wheel_visual">
            <origin xyz="-0.065 0.0126 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".021" length=".001" />
            </geometry>
            <material name="wheel_gray" />
        </visual>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="0.15" />
            <inertia ixx="3.90625e-05" ixy="0" ixz="0" iyy="0.00043625" iyz="0" izz="0.0004128125" />
        </inertial>
    </link>
    <joint name="left_track_joint" type="fixed">
        <parent link="base_link" />
        <child link="left_track_link" />
        <origin xyz="0 0.0675 0.025" rpy="0 0 0" />
    </joint>
    <link name="right_track_link">
        <visual name="right_belt_envelope">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://robot_description/meshes/track_envelope.stl" />
            </geometry>
            <material name="track_dark" />
        </visual>
        <collision name="right_contact">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size=".130 .025 .050" />
            </geometry>
        </collision>
        <collision name="front_round_end">
            <origin xyz="0.065 0 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".025" length=".025" />
            </geometry>
        </collision>
        <visual name="front_wheel_visual">
            <origin xyz="0.065 -0.0126 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".021" length=".001" />
            </geometry>
            <material name="wheel_gray" />
        </visual>
        <collision name="rear_round_end">
            <origin xyz="-0.065 0 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".025" length=".025" />
            </geometry>
        </collision>
        <visual name="rear_wheel_visual">
            <origin xyz="-0.065 -0.0126 0" rpy="1.5707963267948966 0 0" />
            <geometry>
                <cylinder radius=".021" length=".001" />
            </geometry>
            <material name="wheel_gray" />
        </visual>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="0.15" />
            <inertia ixx="3.90625e-05" ixy="0" ixz="0" iyy="0.00043625" iyz="0" izz="0.0004128125" />
        </inertial>
    </link>
    <joint name="right_track_joint" type="fixed">
        <parent link="base_link" />
        <child link="right_track_link" />
        <origin xyz="0 -0.0675 0.025" rpy="0 0 0" />
    </joint>
    <!--Head state only: fixed track envelopes have no belt/roller DOFs yet.-->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/robot/joint_states</topic>
            <joint_name>head_pitch_joint</joint_name>
        </plugin>
    </gazebo>
</robot>